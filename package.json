{
    "name": "asids-erp-cloud",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint resources/js --ext .ts,.vue --max-warnings 0",
        "lint:fix": "eslint resources/js --ext .ts,.vue --fix",
        "format": "prettier --write \"resources/js/**/*.{ts,vue,css}\"",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@vueuse/core": "^12.5.0",
        "axios": "^1.7.9",
        "chart.js": "^4.4.7",
        "pinia": "^2.3.1",
        "vue": "^3.5.13",
        "vue-i18n": "^11.1.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@tailwindcss/forms": "^0.5.10",
        "@types/node": "^22.13.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitest/coverage-v8": "^3.0.5",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.19.0",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^16.8.1",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.5.1",
        "prettier": "^3.4.2",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.3",
        "vite": "^6.0.11",
        "vitest": "^3.0.5",
        "vue-tsc": "^2.2.0"
    }
}
