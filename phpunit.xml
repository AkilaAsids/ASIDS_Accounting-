<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/*/Database/Migrations</directory>
        </exclude>
    </source>
    <coverage>
        <report>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- A real 256-bit key: the encrypter rejects anything else, and the audit
             trail and 2FA secrets both go through it. -->
        <env name="APP_KEY" value="base64:YXNpZHMtdGVzdGluZy1rZXktMzItYnl0ZXMtbG9uZyE="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="asids_erp_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SCOUT_DRIVER" value="null"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Must agree with the state of the test database. The RLS migration runs there, so
             enforcement stays ON: with policies present but enforcement off, nothing publishes
             `asids.tenant_id`, every policy evaluates against NULL, and the whole suite reads
             empty result sets with no error. Fixtures that span workspaces are built under
             `RowLevelSecurity::bypass()`, which is what makes this safe. -->
        <env name="TENANCY_ENFORCE_RLS" value="true"/>
        <env name="AUTH_TWO_FACTOR_ENFORCED" value="false"/>
        <!-- Keeps the suite hermetic: `email:rfc,dns` performs a live DNS lookup, so leaving it on
             would make invitation and sign-up tests depend on egress and on a third party's MX
             records. Syntax validation still applies. -->
        <env name="VALIDATE_EMAIL_DNS" value="false"/>
    </php>
</phpunit>
