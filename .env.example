# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="ASIDS ERP Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://asids.localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Comma separated list, or "*" behind a trusted load balancer only.
TRUSTED_PROXIES=

# ─── Tenancy ─────────────────────────────────────────────────────────────────
# Base host on which tenant subdomains are served: acme.asids.localhost
TENANCY_CENTRAL_DOMAIN=asids.localhost
# header | subdomain | both
TENANCY_IDENTIFICATION=both
TENANCY_ENFORCE_RLS=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=asids_erp
DB_USERNAME=asids_app
DB_PASSWORD=secret
DB_SCHEMA=public
DB_SSLMODE=prefer

# Superuser connection used only by migrations that create roles/policies.
DB_ADMIN_USERNAME=asids_owner
DB_ADMIN_PASSWORD=secret

# ─── Cache / Session / Queue ─────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=asids_cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.asids.localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ─── Horizon ─────────────────────────────────────────────────────────────────
HORIZON_PREFIX=asids_horizon
HORIZON_DOMAIN=
HORIZON_PATH=ops/horizon

# ─── Search ──────────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyChangeMe

# ─── Filesystem / S3 ─────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@asidstech.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Authentication ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=asids.localhost,*.asids.localhost,localhost:5173
SANCTUM_TOKEN_EXPIRATION=

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_HISTORY=5
AUTH_PASSWORD_EXPIRY_DAYS=180
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_TWO_FACTOR_ENFORCED=false
AUTH_SESSION_IDLE_TIMEOUT=30

# ─── Audit ───────────────────────────────────────────────────────────────────
AUDIT_HASH_CHAIN_ENABLED=true
AUDIT_RETENTION_DAYS=2555

# ─── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=/api/v1
